# =============================================================================
# Control Sheet Automation Portal — Backend
# Copy to .env and fill in real values. NEVER commit the populated .env file.
# =============================================================================

# --- Server -------------------------------------------------------------------
APP_ENV=development
PORT=8000
LOG_LEVEL=info

# Comma-separated origins allowed to call this API.
# In production set this to the deployed frontend URL.
CORS_ORIGINS=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key, NOT anon
SUPABASE_BUCKET=processed-workbooks

# How long generated download URLs remain valid (seconds).
DOWNLOAD_URL_TTL_SECONDS=3600
