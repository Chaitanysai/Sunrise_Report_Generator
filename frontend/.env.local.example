# =============================================================================
# Control Sheet Automation Portal — Frontend
# Copy to .env.local and fill in. Variables prefixed NEXT_PUBLIC_ are exposed
# to the browser; unprefixed ones stay server-only.
# =============================================================================

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Placeholder auth: any password equal to this value lets the user "log in".
# Replace with real auth (NextAuth, Supabase Auth, SSO) before going live.
NEXT_PUBLIC_DEMO_PASSWORD=changeme
